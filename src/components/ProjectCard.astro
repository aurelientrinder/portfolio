---
interface Props {
  title: string;
  description: string;
  fullDescription?: string;
  image?: string | string[];
  tags?: string[];
  demo?: string;
  github?: string;
  isAboveFold?: boolean;
}

const { title, description, fullDescription, image, tags = [], demo, github, isAboveFold = false } = Astro.props;
const images = Array.isArray(image) ? image : (image ? [image] : []);

// Prepare data for modal
const projectData = JSON.stringify({
  title,
  description: fullDescription || description,
  images,
  tags,
  demo,
  github
});
---

<article 
  class="card glass animate-fade-in" 
  data-project={projectData}
  tabindex="0"
  role="button"
  aria-label={`View details for ${title}`}
>
  {images.length > 0 && (
    <div class="card-images">
      {images.slice(0, 1).map((img, index) => {
        const shouldEagerLoad = isAboveFold && index === 0;
        return (
          <div class="img-wrapper">
            <img
              src={img}
              alt={title}
              loading={shouldEagerLoad ? "eager" : "lazy"}
              fetchpriority={shouldEagerLoad ? "high" : "auto"}
              decoding="async"
            />
          </div>
        );
      })}
    </div>
  )}
  <div class="card-content">
    <div class="card-header">
      <h2 class="card-title mono">{title}</h2>
      <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <p class="card-description">{description}</p>
    {tags.length > 0 && (
      <div class="card-tags">
        {tags.map((tag) => (
          <span class="tag mono">{tag}</span>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
    cursor: pointer;
    user-select: none;
    background: var(--card-bg);
  }

  .card:hover {
    transform: translateY(-8px) scale(1.01);
    box-shadow: 
      0 20px 40px -20px rgba(0, 0, 0, 0.2),
      0 0 0 1px var(--text-muted);
    background: rgba(255, 255, 255, 0.15);
  }

  @media (prefers-color-scheme: dark) {
    .card:hover {
      background: rgba(255, 255, 255, 0.03);
      box-shadow: 
        0 20px 40px -20px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.1);
    }
  }

  .card:focus {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .card-images {
    padding: 1rem;
    padding-bottom: 0;
  }

  .img-wrapper {
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--accent-soft);
    aspect-ratio: 16 / 10;
    position: relative;
  }

  .img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:hover .img-wrapper img {
    transform: scale(1.08);
  }

  .card-content {
    padding: 2rem 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
    transition: color 0.3s ease;
  }

  .arrow-icon {
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0.3;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .card:hover .arrow-icon {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .card-description {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1;
    font-weight: 450;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tag {
    font-size: 0.65rem;
    color: var(--text-muted);
    background: var(--accent-soft);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    border: 1px solid var(--border);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .card:hover .tag {
    color: var(--text);
    border-color: var(--text-muted);
    background: transparent;
  }
</style>
