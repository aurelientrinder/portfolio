---
import '../styles/global.css';

interface Props {
  title?: string;
  preloadImage?: string;
}

const { title = 'Portfolio', preloadImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Aurélien Trinder" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
