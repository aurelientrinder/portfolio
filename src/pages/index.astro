---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../content/projects.json';
---

<Layout>
  <main class="container">
    <header class="header animate-fade-in">
      <h1 class="title mono">aurelien trinder</h1>
      <p class="subtitle mono">engineer & designer</p>
    </header>

    <section class="bio animate-fade-in" style="animation-delay: 0.15s;">
      <p>
        I'm <span class="highlight">Aurelien Trinder</span>, a 19-year-old engineer driven by the pursuit of technical excellence and the wonders of discovery. Currently, I'm a volunteer engineer at <a href="https://www.timupsinsa.com/" target="_blank" rel="noopener noreferrer" class="subtle-link">TIMUPINSA</a>, where my team and I are developing a homemade 27cc 1-cylinder ethanol-powered engine.
      </p>
      <p>
        I find fascination in the vastness of space and the idea that our universe still holds countless mysteries. I'm guided by Arthur C. Clarke's observation: <em class="quote">"Any sufficiently advanced technology is indistinguishable from magic."</em>
      </p>
    </section>

    <section class="projects">
      <h2 class="section-title mono animate-fade-in" style="animation-delay: 0.3s;">selected work</h2>
      <div class="projects-grid">
        {projects.map((project, index) => (
          <div class="animate-fade-in" style={`animation-delay: ${0.45 + index * 0.15}s;`}>
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </section>

    <footer class="footer animate-fade-in" style="animation-delay: 0.8s;">
      <div class="footer-links mono">
        <a href="https://www.linkedin.com/in/aurelientrinder/" target="_blank" rel="noopener noreferrer">linkedin</a>
        <a href="mailto:trinder.aurelien@gmail.com">email</a>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 8rem 2rem;
  }

  .header {
    margin-bottom: 6rem;
  }

  .title {
    font-family: var(--font-sans);
    font-size: 3.5rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
    color: var(--text);
    background: linear-gradient(to bottom, var(--text) 60%, var(--text-muted));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.1;
  }

  .subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 500;
  }

  .bio {
    margin-bottom: 8rem;
    max-width: 680px;
  }

  .bio p {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    line-height: 1.7;
    font-weight: 400;
  }

  .highlight {
    color: var(--text);
    font-weight: 500;
  }

  .quote {
    color: var(--text-muted);
    font-style: italic;
    background: rgba(125, 125, 125, 0.1);
    padding: 0 0.25rem;
    border-radius: 4px;
  }

  .section-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 3rem;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .section-title::after {
    content: '';
    height: 1px;
    background: linear-gradient(to right, var(--border), transparent);
    flex-grow: 1;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 3rem;
  }

  .footer {
    margin-top: 10rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .footer-links {
    display: flex;
    gap: 3rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .footer-links a {
    color: var(--text-muted);
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .subtle-link {
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    transition: all 0.2s;
  }

  .subtle-link:hover {
    color: var(--text);
    border-bottom-color: var(--text);
  }
</style>
