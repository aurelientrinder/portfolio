---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../content/projects.json';

// Get first image from first project for preloading (LCP optimization)
const firstProject = projects[0];
const firstImage = Array.isArray(firstProject?.image) 
  ? firstProject.image[0] 
  : firstProject?.image;
---

<Layout preloadImage={firstImage}>
  <main class="container">
    <header class="header animate-fade-in">
      <h1 class="title mono">aurelien trinder</h1>
      <p class="subtitle mono">engineer & designer</p>
    </header>

    <section class="bio animate-fade-in" style="animation-delay: 0.15s;">
      <p>
        I'm <span class="highlight">Aurelien Trinder</span>, a 19-year-old engineer driven by the pursuit of technical excellence and the wonders of discovery. Currently, I'm a volunteer engineer at <a href="https://www.timupsinsa.com/" target="_blank" rel="noopener noreferrer" class="subtle-link">TIMUPINSA</a>, where my team and I are developing a homemade 27cc 1-cylinder ethanol-powered engine.
      </p>
      <p>
        I find fascination in the vastness of space and the idea that our universe still holds countless mysteries. I'm guided by Arthur C. Clarke's observation: <em class="quote">"Any sufficiently advanced technology is indistinguishable from magic."</em>
      </p>
    </section>

    <section class="projects">
      <h2 class="section-title mono animate-fade-in" style="animation-delay: 0.3s;">selected work</h2>
      <div class="projects-grid">
        {projects.map((project, index) => (
          <div class="animate-fade-in" style={`animation-delay: ${0.45 + index * 0.15}s;`}>
            <ProjectCard {...project} isAboveFold={index === 0} />
          </div>
        ))}
      </div>
    </section>

    <footer class="footer animate-fade-in" style="animation-delay: 0.8s;">
      <div class="footer-links mono">
        <a href="https://www.linkedin.com/in/aurelientrinder/" target="_blank" rel="noopener noreferrer">linkedin</a>
        <a href="mailto:trinder.aurelien@gmail.com">email</a>
      </div>
    </footer>
  </main>

  <!-- Project Modal -->
  <div class="modal-overlay" id="projectModal" aria-hidden="true">
    <div class="modal-backdrop"></div>
    <div class="modal-container">
      <article class="modal-content">
        <div class="modal-images" id="modalImages"></div>
        <div class="modal-body">
          <h2 class="modal-title" id="modalTitle"></h2>
          <div class="modal-description" id="modalDescription"></div>
          <div class="modal-tags" id="modalTags"></div>
          <div class="modal-links mono" id="modalLinks"></div>
        </div>
      </article>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('projectModal');
    const modalImages = document.getElementById('modalImages');
    const modalTitle = document.getElementById('modalTitle');
    const modalDescription = document.getElementById('modalDescription');
    const modalTags = document.getElementById('modalTags');
    const modalLinks = document.getElementById('modalLinks');
    const backdrop = modal?.querySelector('.modal-backdrop');
    const container = modal?.querySelector('.modal-container');

    // Open modal when card is clicked
    document.querySelectorAll('.card[data-project]').forEach(card => {
      card.addEventListener('click', (e) => {
        const projectData = JSON.parse(card.getAttribute('data-project') || '{}');
        openModal(projectData);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const projectData = JSON.parse(card.getAttribute('data-project') || '{}');
          openModal(projectData);
        }
      });
    });

    function openModal(project: { title?: string; description?: string; images?: string[]; tags?: string[]; demo?: string; github?: string }) {
      if (!modal || !modalImages || !modalTitle || !modalDescription || !modalTags || !modalLinks) return;

      // Populate modal content
      modalTitle.textContent = project.title || '';
      
      // Convert newlines to paragraphs
      const paragraphs = (project.description || '').split('\n\n');
      modalDescription.innerHTML = paragraphs
        .map(p => `<p>${p.replace(/\n/g, '<br>')}</p>`)
        .join('');
      
      // Add images
      modalImages.innerHTML = (project.images || [])
        .map(img => `
          <div class="modal-img-wrapper">
            <img src="${img}" alt="${project.title}" loading="lazy" />
          </div>
        `).join('');
      
      // Add tags
      if (project.tags && project.tags.length > 0) {
        modalTags.innerHTML = project.tags
          .map(tag => `<span class="tag mono">${tag}</span>`)
          .join('');
        modalTags.style.display = 'flex';
      } else {
        modalTags.style.display = 'none';
      }
      
      // Add links
      const links = [];
      if (project.demo) links.push(`<a href="${project.demo}" target="_blank" rel="noopener">Live Demo →</a>`);
      if (project.github) links.push(`<a href="${project.github}" target="_blank" rel="noopener">GitHub ↗</a>`);
      
      if (links.length > 0) {
        modalLinks.innerHTML = links.join('');
        modalLinks.style.display = 'flex';
      } else {
        modalLinks.style.display = 'none';
      }

      // Show modal
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Close modal when clicking backdrop
    backdrop?.addEventListener('click', closeModal);
    
    // Also close when clicking outside modal content
    container?.addEventListener('click', (e) => {
      if (e.target === container) closeModal();
    });
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('active')) {
        closeModal();
      }
    });
  });
</script>

<style>
  .container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 8rem 2rem;
  }

  .header {
    margin-bottom: 6rem;
  }

  .title {
    font-family: var(--font-sans);
    font-size: 3.5rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
    color: var(--text);
    background: linear-gradient(to bottom, var(--text) 60%, var(--text-muted));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.1;
  }

  .subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 500;
  }

  .bio {
    margin-bottom: 8rem;
  }
  
  .bio p {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    line-height: 1.7;
    font-weight: 400;
  }

  .highlight {
    color: var(--text);
    font-weight: 500;
  }

  .quote {
    color: var(--text-muted);
    font-style: italic;
    background: rgba(125, 125, 125, 0.1);
    padding: 0 0.25rem;
    border-radius: 4px;
  }

  .section-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 3rem;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .section-title::after {
    content: '';
    height: 1px;
    background: linear-gradient(to right, var(--border), transparent);
    flex-grow: 1;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 3rem;
  }

  .footer {
    margin-top: 10rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .footer-links {
    display: flex;
    gap: 3rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .footer-links a {
    color: var(--text-muted);
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .subtle-link {
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    transition: all 0.2s;
  }

  .subtle-link:hover {
    color: var(--text);
    border-bottom-color: var(--text);
  }

  /* Modal Styles */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: var(--bg);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .modal-overlay.active .modal-backdrop {
    opacity: 0.97;
  }

  .modal-container {
    position: relative;
    width: 100%;
    max-width: 640px;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    transform: scale(0.96) translateY(20px);
    opacity: 0;
    transition: 
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
  }

  .modal-overlay.active .modal-container {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .modal-content {
    background: var(--bg);
  }

  .modal-images {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .modal-img-wrapper {
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--border);
  }

  .modal-img-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-img-wrapper:hover img {
    transform: scale(1.02);
  }

  .modal-body {
    padding: 0;
  }

  .modal-title {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .modal-description {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .modal-description p {
    margin-bottom: 1rem;
  }

  .modal-description p:last-child {
    margin-bottom: 0;
  }

  .modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .modal-tags .tag {
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--card-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .modal-links {
    display: flex;
    gap: 1.5rem;
    font-size: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .modal-links a {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .modal-links a:hover {
    color: var(--text);
  }

  /* Minimal scrollbar */
  .modal-container::-webkit-scrollbar {
    width: 4px;
  }

  .modal-container::-webkit-scrollbar-track {
    background: transparent;
  }

  .modal-container::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 2px;
  }

  @media (max-width: 600px) {
    .modal-overlay {
      padding: 1.5rem;
    }

    .modal-title {
      font-size: 1.25rem;
    }
  }
</style>
